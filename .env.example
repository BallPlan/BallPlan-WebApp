# Copy this file to .env for local development. Real values go in Vercel's
# project settings for production — never commit an actual .env file.

# Edge-layer gate in front of /admin (see middleware.js). Generate a long
# random value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_GATE_KEY=

# Filled in once the Supabase project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by Edge Functions, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
